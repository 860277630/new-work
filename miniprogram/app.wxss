page { background: #f4f8f6; color: #18342b; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
view, button { box-sizing: border-box; }
button::after { border: none; }
button { font-size: 28rpx; border-radius: 18rpx; }
.screen { padding: 36rpx 32rpx 64rpx; }
.card { background: #fff; border: 1rpx solid #e0ebe5; border-radius: 26rpx; padding: 30rpx; margin-top: 24rpx; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.35; }
.subtitle { font-size: 26rpx; line-height: 1.7; color: #708178; margin-top: 16rpx; }
.primary { background: #176b4b; color: #fff; margin-top: 28rpx; }
.secondary { color: #176b4b; background: #eaf4ee; margin-top: 20rpx; }
.muted { font-size: 24rpx; color: #708178; line-height: 1.7; }
.label { font-size: 28rpx; font-weight: 600; margin-bottom: 18rpx; }
.error { color: #a8352c; font-size: 26rpx; line-height: 1.6; margin-top: 22rpx; }

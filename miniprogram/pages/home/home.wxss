.eyebrow { color: #176b4b; letter-spacing: 3rpx; font-size: 22rpx; font-weight: 600; }
.hero { padding: 30rpx 0 48rpx; }
.accent { display: block; color: #176b4b; }
.hero-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 28rpx; }
.hero-tags text { border: 1rpx solid #d7e6dc; border-radius: 100rpx; padding: 8rpx 18rpx; font-size: 22rpx; color: #526b5d; }
.section-heading { display: flex; justify-content: space-between; font-size: 28rpx; font-weight: 600; margin-bottom: 22rpx; }
.history-link { color: #176b4b; font-size: 24rpx; font-weight: 400; }
.tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.tool-card { border-radius: 24rpx; padding: 28rpx 22rpx; min-height: 245rpx; }
.mint { background: #e2f1e6; } .blue { background: #e4eef6; } .sand { background: #f5ecda; } .lilac { background: #ece8f5; }
.tool-number { opacity: .6; font-size: 22rpx; display: flex; justify-content: space-between; margin-bottom: 36rpx; }
.tool-arrow { font-size: 32rpx; }
.tool-title { font-size: 30rpx; font-weight: 650; }
.tool-description { font-size: 23rpx; line-height: 1.6; margin-top: 12rpx; color: #60706a; }
.privacy { margin-top: 30rpx; }
